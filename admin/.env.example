VITE_API_URL=http://localhost:5000/api/v1

# ---- Live sales demo -------------------------------------------------------------------------------------------------------
# The demo admin: every call is answered from the demo shop's data in the visitor's browser instead of the API. Leave all of this
# out on a customer's copy. Needs the demo storefront (frontend, NEXT_PUBLIC_DEMO_MODE=true) running next to it.
# Turn it on by uncommenting the next line and restarting/rebuilding.
# VITE_DEMO_MODE=true
# The demo storefront's data hub page (default for local development: http://localhost:3000/demo-hub/index.html). The admin and
# the storefront must be on the same registered domain (demo.example.com + demo.admin.example.com), not two *.vercel.app names.
# VITE_DEMO_HUB_URL=https://demo.yourstore.com/demo-hub/index.html
# Optional: the "Get this store" button.
# VITE_DEMO_CTA_URL=
# VITE_DEMO_CTA_LABEL=Get this store
