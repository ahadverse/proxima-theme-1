# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/maroon

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
# SameSite of the login cookies. Leave empty for the default (none in production, so a storefront, an admin and an API on
# different sites work; lax in development). Use lax or strict when they all share one site.
COOKIE_SAMESITE=
# How many reverse proxies sit in front of the API (default 1: Cloudflare, nginx, a platform's load balancer). Use 0 when
# the API is reached directly, otherwise a client can fake its address and slip past the rate limits.
TRUST_PROXY=

# Shared with the storefront's REVALIDATE_SECRET (same value in both). Lets a Settings save in the admin
# (theme colours, store name, contact details...) reach the storefront at once instead of within a minute.
# Development has a built-in default; production must set it. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value also lets the storefront's server read the API under its own, much higher rate limit (it renders pages for
# every visitor from a single address).
REVALIDATE_SECRET=

# Secrets encryption (Settings payment/courier/pixel/fraud credentials at rest)
# Must be a 32-byte value. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Image uploads — Cloudflare R2 (used when all five of these are set; check them with: npm run check:storage)
# Cloudflare dashboard -> R2 -> Manage API tokens -> Create API token (Object Read & Write, on your bucket).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are the "Access Key ID" and "Secret Access Key" that page shows once
# (NOT the "Token value"). R2_ACCOUNT_ID is on the R2 overview page. R2_PUBLIC_URL is the bucket's public address:
# its https://pub-....r2.dev URL (bucket Settings -> Public access), or your own domain connected to it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Only for a bucket in the EU / FedRAMP jurisdiction, e.g. https://<account id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Image uploads — Cloudinary (optional alternative; only used when the R2 settings above are empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics: the timezone that decides where a "day" starts (daily revenue, 7/30/90-day ranges).
# Any IANA name, e.g. Asia/Dhaka (default), Asia/Kolkata, Europe/London.
STORE_TIMEZONE=Asia/Dhaka

# Seed / bootstrap admin
SEED_ADMIN_EMAIL=admin@maroon.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Live sales demo (leave all of this out on a customer's copy — it is off unless DEMO_MODE=true).
# true = payments, courier booking and the ad pixel are simulated, a "Demo store" banner shows in the
# storefront and admin, and visitor data is wiped and the catalogue restored every night.
DEMO_MODE=false
# Where the banner's button points (your sales page). No URL = no button.
DEMO_CTA_URL=
DEMO_CTA_LABEL=Get this store
# When the nightly reset runs, in STORE_TIMEZONE (cron syntax). Default: 03:00.
DEMO_RESET_CRON=0 3 * * *
